{
  "schema_version": "1.0.0",
  "contract_id": "KASKAD-QUALITY-MATHEMATICS",
  "scope": "all mathematical definitions, claims, models and proofs",
  "mandatory": {
    "every_construction_has_signature_and_semantics": true,
    "every_axiom_has_scope_and_motivation": true,
    "every_theorem_has_quantifiers_and_assumptions": true,
    "every_proof_lists_dependencies": true,
    "every_new_term_has_classical_crosswalk": true,
    "every_universal_claim_is_proof_or_open_problem": true,
    "every_definition_has_example_and_boundary_case": true,
    "every_algorithm_has_invariant_and_termination_argument": true,
    "every_nontrivial_operation_declares_domain_and_codomain": true,
    "every_metric_declares_its_space_and_axioms": true,
    "raw_convolution_and_canonical_normalization_are_distinguished": true,
    "entropy_definitions_require_positive_total_mass": true,
    "cross_domain_encodings_preserve_declared_types": true,
    "encoding_isomorphism_claims_require_explicit_proof": true,
    "prefix_ultrametrics_and_low_digit_metrics_are_not_conflated": true,
    "directed_block_composition_is_separate_from_numeric_addition": true,
    "positional_zero_groups_are_never_silently_removed": true,
    "CRT_projectors_are_compatible_across_modular_levels": true,
    "infinite_K3_expansion_has_an_explicit_topological_domain": true,
    "ordinary_integer_tail_classification_states_finite_support_or_eventual_999": true,
    "the_two_channel_unit_criterion_uses_gcd_with_1000": true,
    "carry_correlations_declare_the_fixed_incoming_carry_and_input_distribution": true,
    "every_counterexample_names_the_rejected_claim_and_exact_witness": true,
    "theorem_and_hypothesis_statuses_are_tracked_by_stable_claim_id": true,
    "proof_review_and_machine_check_status_are_separate": true,
    "applied_models_do_not_inherit_theorem_status_from_source_domain": true,
    "defect_load_requires_explicit_invariant_registry": true,
    "defect_load_requires_complete_fixed_observation_coverage": true,
    "unassessed_observations_are_not_zero": true,
    "negative_tendency_levels_require_predeclared_thresholds": true,
    "dependency_clusters_declare_weak_connectivity": true,
    "directed_propagation_is_distinct_from_cluster_connectivity": true,
    "normalized_local_defect_load_is_bounded": true,
    "medical_metaphors_are_not_medical_claims": true,
    "every_integer_multiplicity_declares_typed_relation_and_domain": true,
    "integer_divisibility_uses_exact_quotient_remainder": true,
    "composite_radix_1000_divisibility_checks_both_prime_channels": true,
    "composite_base_depth_uses_product_compensation_law": true,
    "prime_factor_multiplicity_is_distinct_from_radix_depth": true,
    "positional_scale_preserves_explicit_zero_groups": true,
    "multiset_repetition_does_not_collapse_to_set": true,
    "multiplicity_claims_include_boundary_cases_and_counterexamples": true,
    "multiplicity_claims_follow_K3_IME_1_0_0": true,
    "equivalence_collapse_requires_common_typed_carrier": true,
    "description_complexity_does_not_imply_object_nonexistence": true,
    "integrals_declare_density_domain_and_measure": true,
    "semantic_load_metrics_are_operationally_defined": true
  },
  "k3_constraints": {
    "radix": 1000,
    "factorization": "2^3 * 5^3",
    "group_separator": "k",
    "coefficient_range": "0..999",
    "canonical_expansion_uniqueness": "theorem_from_euclidean_division",
    "normalization_invariant": "preserve_polynomial_value",
    "divisor_filter": "not_a_multiplicative_valuation",
    "modular_ring_1000": "not_a_field",
    "completion": "inverse_limit_isomorphic_to_Z2_times_Z5",
    "notation_and_semantics": {
      "radix_symbol": "B",
      "radix_value": 1000,
      "separator_symbol": "k",
      "separator_role": "lexical_group_delimiter",
      "numeric_shift_operator": "S_B",
      "raw_coefficient_domain": "Z",
      "canonical_coefficient_range": "0..999",
      "canonical_zero_word": "0",
      "empty_word_is_canonical": false,
      "evaluation_kernel": "(X-1000)",
      "empty_sum": 0,
      "empty_product": 1,
      "undefined_marker": "outside_Z"
    },
    "composite_radix_arithmetic": {
      "crt_components": [
        "2^(3r)",
        "5^(3r)"
      ],
      "unit_criterion": "gcd(n,1000)=1",
      "unit_count": "(2/5)*1000^r",
      "nonzero_zero_divisor_count": "(3/5)*1000^r-1",
      "divisor_product_law": "nu_1000(xy)>=nu_1000(x)+nu_1000(y)",
      "residue_tree_branching": {
        "2_primary_branch_factor": 8,
        "5_primary_branch_factor": 125,
        "total": 1000
      },
      "unit_test_depends_on": "least_significant_K3_group",
      "divisor_product_compensation_law": "nu_1000(xy)=nu_1000(x)+nu_1000(y)+chi_B(x,y), for nonzero x,y"
    },
    "extension_layers": {
      "biprime_base_factorization": "1000=2^3*5^3",
      "crt_levels": [
        "2^(3r)",
        "5^(3r)"
      ],
      "profile_morphology": [
        "moments",
        "convolution",
        "affine_positions",
        "finite_differences",
        "transport",
        "entropy",
        "fourier",
        "prefix_ultrametric",
        "q_addend_carries",
        "lag_moments"
      ],
      "directed_composition": "separate_noncommutative_sequence_concatenation",
      "negative_tendency_model": [
        "explicit_invariant_registry_and_applicability",
        "complete_fixed_observation_coverage",
        "unassessed_is_not_zero",
        "normalized_local_load_in_0_to_1",
        "weakly_connected_defect_clusters",
        "directed_dependency_propagation_with_componentwise_cap",
        "predeclared_twenty_level_thresholds",
        "metaphorical_labels_are_not_medical_claims"
      ]
    }
  },
  "forbidden": {
    "empirical_observation_as_universal_proof": true,
    "finite_sample_as_infinite_proof": true,
    "unqualified_p_adic_analogy_for_composite_base": true,
    "calling_Z_mod_1000_a_field": true,
    "claiming_bit_compression_without_encoding_proof": true,
    "unsupported_performance_superlatives": true,
    "redefining_standard_terms_without_definition": true,
    "assuming_nu_1000_zero_implies_unit": true,
    "using_k_as_both_numeric_radix_and_word_separator": true,
    "treating_empty_word_as_canonical_zero": true,
    "identifying_null_or_undefined_with_integer_zero": true,
    "claiming_cryptographic_security_from_modular_arithmetic_alone": true,
    "inventing_doi_arxiv_authorship_or_benchmark_results": true,
    "marking_unexecuted_reference_vector_as_pass": true,
    "claiming_4685_catalogue_entries_are_4685_independent_discoveries": true,
    "treating_raw_convolution_as_canonical_normalized_product": true,
    "treating_directed_composition_as_integer_addition": true,
    "assuming_serialization_proves_domain_isomorphism": true,
    "claiming_implementation_from_a_mathematical_contract": true,
    "treating_the_1000_adic_completion_as_the_ordinary_integer_ring": true,
    "claiming_statistical_independence_from_CRT_coordinate_independence": true,
    "describing_correlation_conditional_on_the_next_carry_as_defined_when_that_carry_is_fixed": true,
    "using_1000_not_dividing_x_as_a_unit_criterion": true,
    "rounding_or_approximate_ratio_as_divisibility_proof": true,
    "conflating_integer_multiplier_with_power_exponent_or_factor_multiplicity": true,
    "assuming_nu_1000_is_multiplicative": true,
    "using_nonzero_low_group_as_modular_unit_test": true,
    "using_plain_set_when_repetition_counts_matter": true,
    "scoring_evidence_status_as_mathematical_truth": true,
    "identifying_empty_set_with_numeric_zero_or_scalar_without_typed_map": true,
    "evaluating_real_functions_at_empty_set": true,
    "treating_semantic_overhead_as_a_standard_number_class": true,
    "inferring_object_nonexistence_from_description_quality": true
  },
  "review": {
    "mathematical_review_required": true,
    "counterexample_review_required": true,
    "dependency_graph_review_required": true,
    "status_change_requires_audit_trail": true,
    "independent_proof_review_required_for_verified_status": true,
    "computational_checks_never_promote_universal_claims_to_theorems": true,
    "status_changes_require_commit_scoped_evidence": true,
    "external_recognition_requires_verifiable_external_record": true,
    "self_review_is_not_independent_review": true,
    "scientific_maturity_must_not_be_collapsed_into_one_score": true
  },
  "documentation": {
    "standard": "Cascade Edition 1.0.0",
    "normative_document": "docs/SCIENTIFIC_MATHEMATICAL_DOCUMENTATION_STANDARD.md",
    "language_register": "docs/LANGUAGE_REGISTER.md",
    "required": {
      "document_type_and_research_status": true,
      "formal_scope_and_assumptions": true,
      "symbol_table_and_index_conventions": true,
      "theorem_proof_or_explicit_open_status": true,
      "exact_and_approximate_results_separated": true,
      "computational_claims_have_reproducibility_manifest": true,
      "citations_and_license_are_not_invented": true,
      "translation_completeness_is_explicit": true,
      "changes_in_epistemic_status_have_audit_trail": true
    },
    "non_applicable_fields_must_be_explicit": true,
    "no_unverified_doi_or_arxiv_identifier": true,
    "no_unmeasured_benchmark_claims": true,
    "no_unexecuted_test_marked_pass": true,
    "no_unimplemented_algorithm_reported_as_implemented": true,
    "multiplicity_evidence_standard": "K3-IME 1.0.0"
  }
}
