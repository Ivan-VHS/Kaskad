    "executable_tools_are_optional_support_for_mathematical_verification",
    "computation_and_experiment_do_not_replace_proofs"
  ],
  "theory": {
    "id": "K3",
    "name": "Теория Вьюненко",
    "specification_version": "0.5.0",
    "radix": 1000,
    "radix_factorization": {
      "2": 3,
      "5": 3
    },
    "group_separator": "k",
    "coefficient_domain": [
      0,
      999
    ],
    "nonnegative_value_domain": "N0",
    "signed_value_domain": "Z",
    "value_semantics": "sum(a_i * radix^i)",
    "canonical_form_required": true,
    "normalization_preserves_value": true,
    "composite_radix": true,
    "divisor_function_is_multiplicative": false,
    "completion": "inverse_limit_Z_mod_1000_power_r",
    "completion_ring": "Z_2 x Z_5",
    "zero_word": "0",
    "empty_word_is_canonical": false,
    "separator_semantics": "lexical_group_delimiter",
    "shift_operator": "S_B",
    "extensions": [
      "1000_adic_inverse_limit_and_compatible_CRT_idempotents",
      "biprime_residue_geometry_and_carry_distribution",
      "finite_profile_morphology_and_moment_layers",
      "directed_block_composition_separate_from_addition",
      "typed_applied_mathematical_models_DAK_Reaper_VentuSample",
      "higher_structures_homology_sheaves_stratification_HoTT_schemes_fractals_semantic_layers"
    ]
  },
