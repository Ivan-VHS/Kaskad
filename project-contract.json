{
  "schema_version": "1.0.0",
  "project": {
    "id": "KASKAD",
    "name": "Kaskad",
    "mission": "Permanent mathematical research corpus for the Vyunenko Theory of K3 and rigorously defined extensions across mathematics.",
    "primary_language": "mathematical-documentation-first",
    "implementation_policy": "Executable tools are optional supporting instruments for exact calculation, finite verification, reproducible mathematical experiments or formal proof. Kaskad is not an operating-system, programming-language, IDE, application or general-purpose software-product project. Cross-repository relations are mathematical only."
  },
  "scope_boundary": [
    "mathematics_is_the_permanent_primary_scope",
    "cross_repository_relationships_are_mathematical_only",
