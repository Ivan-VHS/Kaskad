  ],
  "implementation_state": {
    "status": "mathematical_documentation_and_research_methods",
    "note": "Executable components are optional supporting instruments. Their presence or specification does not change the mathematical scope of Kaskad."
  },
  "release_gates": [
    "mathematical_semantics_reviewed",
