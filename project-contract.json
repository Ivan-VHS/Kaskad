{
  "schema_version": "1.0.0",
  "project": {
    "id": "KASKAD",
    "name": "Kaskad",
    "mission": "Permanent mathematical research corpus for the Vyunenko Theory of K3 and rigorously defined extensions across mathematics.",
    "primary_language": "mathematical-documentation-first",
    "implementation_policy": "Executable tools are optional supporting instruments for exact calculation, finite verification, reproducible mathematical experiments or formal proof. Kaskad is not an operating-system, programming-language, IDE, application or general-purpose software-product project. Cross-repository relations are mathematical only."
  },
  "scope_boundary": [
    "mathematics_is_the_permanent_primary_scope",
    "cross_repository_relationships_are_mathematical_only",
    "no_operating_system_programming_language_ide_driver_or_application_product_scope",
    "executable_tools_are_optional_support_for_mathematical_verification",
    "computation_and_experiment_do_not_replace_proofs"
  ],
  "theory": {
    "id": "K3",
    "name": "Теория Вьюненко",
    "specification_version": "0.1.0",
    "radix": 1000,
    "radix_factorization": {
      "2": 3,
      "5": 3
    },
    "group_separator": "k",
    "coefficient_domain": [
      0,
      999
    ],
    "nonnegative_value_domain": "N0",
    "signed_value_domain": "Z",
    "value_semantics": "sum(a_i * radix^i)",
    "canonical_form_required": true,
    "normalization_preserves_value": true,
    "composite_radix": true,
    "divisor_function_is_multiplicative": false,
    "completion": "inverse_limit_Z_mod_1000_power_r",
    "completion_ring": "Z_2 x Z_5"
  },
  "scope": [
    "mathematical_logic_and_axiomatics",
    "set_theory_and_formal_semantics",
    "algebra",
    "arithmetic_and_number_theory",
    "geometry_and_topology",
    "mathematical_analysis",
    "functional_analysis",
    "trigonometry",
    "combinatorics",
    "probability",
    "statistics",
    "numerical_methods",
    "optimization",
    "computational_mathematics",
    "experimental_mathematics",
    "formal_proof_and_evidence",
    "p_adic_and_composite_adic_analysis",
    "computability_theory",
    "quantum_operator_models",
    "category_theory_and_homological_algebra",
    "knot_theory_and_topological_invariants",
    "analytic_number_theory",
    "cooperative_formula_synthesis"
  ],
  "architecture_layers": [
    "logic_and_axiomatic_foundations",
    "canonical_k3_core",
    "fundamental_mathematical_structures",
    "discipline_engines",
    "exact_and_numerical_computation",
    "experimental_research_laboratory",
    "proof_and_evidence_registry"
  ],
  "epistemic_statuses": [
    "axiom",
    "definition",
    "assumption",
    "lemma",
    "theorem",
    "corollary",
    "conjecture",
    "counterexample",
    "finite_exhaustive_verification",
    "computational_observation",
    "empirical_observation",
    "numerical_estimate",
    "heuristic",
    "rejected",
    "conditional_result",
    "research_program",
    "speculative_model",
    "metaphorical_interpretation",
    "not_formulated"
  ],
  "numerical_policy": {
    "exact_integer_arithmetic": "required_for_discrete_core",
    "rational_normalization": "required",
    "floating_point": "explicit_approximation_only",
    "interval_arithmetic": "required_for_guaranteed_numeric_bounds",
    "rounding_mode": "must_be_explicit",
    "angle_default_unit": "radian",
    "physical_dimensions": "must_be_type_checked",
    "overflow": "must_never_be_silent"
  },
  "experiment_policy": {
    "deterministic_by_default": true,
    "random_seed_required": true,
    "prng_identifier_required": true,
    "dataset_checksum_required": true,
    "code_revision_required": true,
    "empirical_results_are_proofs": false,
    "benchmark_requires_correctness_check": true
  },
  "required_documents": [
    "docs/VYUNENKO_THEORY.md",
    "docs/K3_CANONICAL_SYNTAX.md",
    "docs/CHAPTER_II_CASCADE_BALANCE.md",
    "docs/K3_COMPOSITE_RADIX_ARITHMETIC.md",
    "docs/CLASSICAL_MATHEMATICS_CROSSWALK.md",
