  "research_extensions": [
    {
      "id": "CV-1",
      "title": "Теория Чумного Вердикта",
      "version": "1.2.0",
      "status": "formal_specification_with_idempotent_output_projection",
      "source": "docs/CHUMNY_VERDICT_THEORY.md",
      "parameter_domain": "c in Z, c != 0",
      "primary_relation": "x prec_c y iff x = 0 and y = c",
      "additive_transition": "x leads_to_c y iff y = x + c",
      "base_semantics_changed": false,
      "notes": [
        "Ordinary integer identity and arithmetic are unchanged",
        "The primary directed relation contains exactly one ordered pair (0,c)",
        "Additive propagation is modelled as a directed translation graph",
        "Unrestricted multiplication changes the parameter and is not a closure rule for fixed c",
        "No claim of a new alternative arithmetic of integers is made",
        "TCV-K3 lifts the fixed directed CV relation to compatible typed carriers without replacing ordinary equality",
        "K3 positional zero slots retain their indices even when their numeric contribution is zero",
        "The zero-divisor example is in Z/1000Z; it is not an equality 625*376=0 in Z",
        "The evidence verdict distinguishes exact zero, exact nonzero, unknown, absent, and invalid states",
        "CV-P stores raw integer evaluation separately from the projected output",
        "CV-P is idempotent, has image Z excluding 0, and has the sole nontrivial fiber {0,c}",
        "The equivalence induced by CV-P is not a congruence for ordinary addition",
        "CV-P applies after full K3 evaluation and never to individual positional zero coefficients"
      ],
      "typed_k3_layer": {
        "id": "TCV-K3",
        "title": "Каскадно-типизированное расширение",
        "status": "compatible_formal_extension",
        "sections": [
          "typed_additive_domains",
          "lifted_directed_relation",
          "value_and_structural_equality",
          "positional_zero_identity",
          "residue_ring_zero_divisors",
          "five_state_evidence_verdict"
        ],
        "verdict_states": [
          "ZERO",
          "NONZERO",
          "UNKNOWN",
          "ABSENT",
          "INVALID"
        ],
        "base_semantics_changed": false
      },
      "verdict_projection": "P_c(n)=c if n=0; n otherwise",
      "raw_evaluation_preserved": true,
      "projection_idempotent": true,
      "projection_image": "Z excluding 0",
      "projection_nontrivial_fiber": [
        "0",
        "c"
      ],
      "projection_kernel_is_additive_congruence": false,
      "model": "docs/CHUMNY_VERDICT_MODEL.v1.json",
      "schema": "schemas/chumny-verdict.v1.schema.json"
    },
    {
      "id": "KASKAD-KTM-1",
      "title": "Математическая модель переходов исследовательского знания Kaskad",
      "version": "1.0.0",
      "status": "normative_methodological_model",
      "source": "docs/MATHEMATICAL_KNOWLEDGE_TRANSITION_MODEL.md",
