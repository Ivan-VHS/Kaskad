{
  "schema_version": "1.0.0",
  "standard_id": "K3-IME-1.0.0",
  "project": "Kaskad",
  "theory_id": "K3",
  "theory_version": "0.5.0",
  "radix": 1000,
  "radix_factorization": {
    "2": 3,
    "5": 3
  },
  "coefficient_range": [
    0,
    999
  ],
  "coefficient_order": "least_significant_to_most_significant",
  "status_vocabulary": [
    "met",
    "partial",
    "not_met",
    "not_applicable",
    "not_audited"
  ],
  "criteria": [
    {
      "id": "IME-01",
      "label": "Показатель Доказательства Целых кратностей",
      "mandatory": true,
      "test": "Утверждение задаёт точное отношение и область действия.",
      "evidence": "Формула, домен и источник."
    },
    {
      "id": "IME-02",
      "label": "Мерило Аргументации Целочисленных множителей",
      "mandatory": true,
      "test": "Для делимости предъявлен целый множитель q.",
      "evidence": "Равенство n=q*d или доказательство существования q."
    },
    {
      "id": "IME-03",
      "label": "Признак Подтверждения Целочисленных множительностей",
      "mandatory": true,
      "test": "Свидетель q проверен точной арифметикой.",
      "evidence": "Точное равенство и независимая проверка."
    },
    {
      "id": "IME-04",
      "label": "Параметр Подкрепления Целых числовых кратностей",
      "mandatory": true,
      "test": "Область чисел и типы переменных объявлены.",
      "evidence": "Z, N или N0 и ограничения."
    },
    {
      "id": "IME-05",
      "label": "Оценка Доводы Дискретных кратностей",
      "mandatory": true,
      "test": "Округление не используется как доказательство делимости.",
      "evidence": "Евклидово деление и остаток."
    },
    {
      "id": "IME-06",
      "label": "Индикатор Аргументы Натуральных кратностей",
      "mandatory": true,
      "test": "Различаются q в N0 и q в N.",
      "evidence": "Явная область натурального множителя."
    },
    {
      "id": "IME-07",
      "label": "Стандарт Мотивировки Целочисленных коэффициентов кратности",
      "mandatory": true,
      "test": "Различаются q, a_i, v_p, nu_B и число повторений.",
      "evidence": "Таблица типов обозначений."
    },
    {
      "id": "IME-08",
      "label": "Норматив Пояснения Кратностей в целых числах",
      "mandatory": true,
      "test": "Определение имеет смысл, пример и границу.",
      "evidence": "Дефиниция и контрпример к неверному расширению."
    },
    {
      "id": "IME-09",
      "label": "Требование Разъяснения Целых степеней кратности",
      "mandatory": true,
      "test": "Различаются q*d, d^r и B^r.",
      "evidence": "Определение каждого показателя."
    },
    {
      "id": "IME-10",
      "label": "Условие Обоснованные утверждения Целочисленных повторений",
      "mandatory": true,
      "test": "Повторная сумма отделена от факторной кратности и мультимножества.",
      "evidence": "Рекурсия или точная формула числа повторов."
    },
    {
      "id": "IME-11",
      "label": "Основание Доказательные положения Целых множительных соотношений",
      "mandatory": true,
      "test": "Предпосылки и зависимости перечислены.",
      "evidence": "Список определений, лемм и внешних результатов."
    },
    {
      "id": "IME-12",
      "label": "Показатель соответствия Логические основания Дискретных целочисленных множителей",
      "mandatory": true,
      "test": "Для iff доказаны обе импликации.",
      "evidence": "Полное доказательство обеих сторон."
    },
    {
      "id": "IME-13",
      "label": "Оценочный параметр Теоретические основания Целочисленных масштабных коэффициентов",
      "mandatory": true,
      "test": "Масштабирование задано типизированным отображением.",
      "evidence": "Область, кодомен и инварианты."
    },
    {
      "id": "IME-14",
      "label": "Контрольный показатель Научные подтверждения Целых пропорциональных кратностей",
      "mandatory": true,
      "test": "Целая кратность отделена от рационального отношения.",
      "evidence": "Точный остаток и целочисленность частного."
    },
    {
      "id": "IME-15",
      "label": "Квалификатор Фактические подтверждения Арифметических кратностей",
      "mandatory": true,
      "test": "Вычисление имеет происхождение и параметры.",
      "evidence": "Векторы, версия кода, протокол и статус запуска."
    },
    {
      "id": "IME-16",
      "label": "Ориентир Рациональные доводы Целочисленных коэффициентных отношений",
      "mandatory": true,
      "test": "Рациональное отношение не выдаётся за делимость.",
      "evidence": "Сокращённая дробь и остаток 0."
    },
    {
      "id": "IME-17",
      "label": "Эталон Логические доказательства Целых кратных величин",
      "mandatory": true,
      "test": "Универсальное утверждение имеет доказательство.",
      "evidence": "Паспорт теоремы и полное доказательство."
    },
    {
      "id": "IME-18",
      "label": "Метрика Подтверждающие сведения Целочисленных кратных значений",
      "mandatory": true,
      "test": "Проверены нулевые, граничные и контрпримерные случаи.",
      "evidence": "Точные эталонные векторы."
    },
    {
      "id": "IME-19",
      "label": "Правило оценки Документальные свидетельства Кратных целочисленных отношений",
      "mandatory": true,
      "test": "Происхождение и история статуса воспроизводимы.",
      "evidence": "Путь, раздел, ревизия и ссылка."
    },
    {
      "id": "IME-20",
      "label": "Критериальный признак Концептуальные аргументы Целочисленных мультипликативных коэффициентов",
      "mandatory": true,
      "test": "Исключены смешение понятий и чрезмерные обобщения.",
      "evidence": "Типовой анализ, контрпримеры и ограничения."
    }
  ],
