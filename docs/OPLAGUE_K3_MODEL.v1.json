  "models": {
    "candidate_graph": {
      "kind": "bipartite-graph",
      "edge_rule": "normalized_device_ids intersection normalized_package_ids is non-empty",
      "edge_semantics": "candidate-only; not compatibility, trust, safety or installation authorization",
      "bounds": {
        "devices": 20000,
        "packages": 5000,
        "ids_per_record": 256,
        "candidate_edges": 100000
      }
    },
    "udrv_v1": {
      "kind": "manifest-to-container-integrity",
      "path_set_equality": true,
      "per_entry_fields": [
        "canonical_relative_path",
        "byte_size",
        "sha256"
      ],
      "bounds": {
        "manifest_bytes": 4194304,
        "archive_entries": 10000,
        "file_bytes": 536870912,
        "total_payload_bytes": 2147483648,
        "hash_read_buffer_bytes": 1048576
      },
      "sha256_proves_publisher_authenticity": false,
      "extracts_or_executes_payload": false
    },
    "metric_profiles": {
      "domain": "[0,1]^n",
      "requires_same_dimensions": true,
      "euclidean": "sqrt(sum((x_i-y_i)^2))",
      "weighted": "sqrt(sum(w_i*(x_i-y_i)^2)), w_i>=0",
      "positive_weights_yield_metric": true,
      "zero_weights_may_yield_pseudometric": true,
      "cosine_undefined_for_zero_norm": true,
      "repeat_variance": "sample variance with denominator m-1 for m>=2"
    },
    "evidence": {
      "states": [
        "single_source",
        "multi_source_consistent",
        "conflicted"
      ],
      "group_key": [
        "pseudonymous_subject",
        "exact_attribute",
        "exact_time_window"
      ],
      "identifier_protection": "HMAC-SHA-256 with domain separation and caller-managed key",
      "same_key_allows_cross_snapshot_linkage": true,
      "pseudonymization_is_anonymization": false,
      "sha256_is_source_authentication": false
    },
    "telemetry": {
      "mode": "read-only",
      "current_gpu_provider": "NVIDIA",
      "unknown_sensor_value": "null",
      "maximum_gpu_records": 16,
      "utc_timestamp_is_monotonic_clock": false,
      "telemetry_grants_device_control": false
    },
    "transactions": {
      "kind": "bounded-in-memory-evidence-transaction",
      "default_payload_limit_bytes": 8388608,
      "commit_rule": "expected_generation equals current_generation",
      "migration_rule": "target_schema_version strictly increases",
