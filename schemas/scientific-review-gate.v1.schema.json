{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/Kaskad/blob/main/schemas/scientific-review-gate.v1.schema.json",
  "title": "Kaskad Scientific Review Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "scope",
    "audit",
    "status_vocabulary",
    "gate_policy",
    "criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "const": "Kaskad"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "branch",
        "revision",
        "method",
        "limitations",
        "current_main_ci"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "branch": {
          "const": "main"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "method": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "current_main_ci": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "run_id",
              "conclusion",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "run_id": {
                "type": "integer"
              },
              "conclusion": {
                "enum": [
                  "success",
                  "failure",
                  "cancelled",
                  "timed_out",
                  "action_required",
                  "stale",
                  "skipped",
                  "neutral"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "status_vocabulary": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "meaning"
        ],
        "properties": {
          "value": {
            "enum": [
              "covered_by_repository_artifact",
              "partially_covered",
              "not_verified",
              "external_action_pending",
              "not_applicable"
            ]
          },
          "meaning": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_1_20",
        "stage_39_46",
        "stage_53_58",
        "interpretation"
      ],
      "properties": {
        "stage_1_20": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criteria",
            "ready",
            "rule"
          ],
          "properties": {
            "criteria": {
              "const": "1-20"
            },
            "ready": {
              "type": "boolean"
            },
            "rule": {
              "type": "string"
            }
          }
        },
        "stage_39_46": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criteria",
            "ready",
            "rule"
          ],
          "properties": {
            "criteria": {
              "const": "39-46"
            },
            "ready": {
              "type": "boolean"
            },
            "rule": {
              "type": "string"
            }
          }
        },
        "stage_53_58": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criteria",
            "ready",
            "rule"
          ],
          "properties": {
            "criteria": {
              "const": "53-58"
            },
            "ready": {
              "type": "boolean"
            },
            "rule": {
              "type": "string"
            }
          }
        },
        "interpretation": {
          "type": "string"
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "section",
          "title",
          "requirement",
          "status",
          "evidence",
          "assessment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KASKAD-SR-(0[0-9]{2}|060)$"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "section": {
            "enum": [
              "I",
              "II",
              "III",
              "IV",
              "V",
              "VI",
              "VII"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "requirement": {
            "type": "string",
            "minLength": 12
          },
          "status": {
            "enum": [
              "covered_by_repository_artifact",
              "partially_covered",
              "not_verified",
              "external_action_pending",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "role"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
                },
                "role": {
                  "type": "string",
                  "minLength": 8
                }
              }
            }
          },
          "assessment": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}
