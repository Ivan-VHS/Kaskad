{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ivan-VHS/Kaskad/blob/main/schemas/omega-claim-registry.v1.schema.json",
  "title": "K3-Omega claim registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "extension",
    "extension_version",
    "source_of_truth",
    "compatibility",
    "status_vocabulary",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "const": "Kaskad"
    },
    "extension": {
      "const": "K3-Omega"
    },
    "extension_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source_of_truth": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserves_k3_radix",
        "preserves_k3_separator",
        "relation_to_k3"
      ],
      "properties": {
        "preserves_k3_radix": {
          "const": 1000
        },
        "preserves_k3_separator": {
          "const": "k"
        },
        "relation_to_k3": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status_vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "statement",
          "source",
          "dependencies",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OMG-(DEF|AX|OP|THM|HYP|Q)-\\d{3}$"
          },
          "kind": {
            "enum": [
              "definition",
              "postulate",
              "operator",
              "theorem",
              "open_hypothesis",
              "open_problem",
              "counterexample",
              "model"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 12
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "assumptions"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "proof_reference": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "theorem"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "proof_reference"
              ]
            }
          }
        ]
      }
    }
  }
}
