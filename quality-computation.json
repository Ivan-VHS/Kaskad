{
  "schema_version": "1.0.0",
  "contract_id": "KASKAD-QUALITY-COMPUTATION",
  "scope": "all future executable mathematical and research components",
  "numeric_types": {
    "integer": {
      "exact": true,
      "arbitrary_precision": true
    },
    "rational": {
      "exact": true,
      "normalized": true,
      "denominator_nonzero": true
    },
    "modular": {
      "modulus_explicit": true,
      "inverse_requires_coprimality": true
    },
    "algebraic": {
      "exact_representation_required": true
    },
    "floating_point": {
      "approximate": true,
      "format_explicit": true,
      "rounding_explicit": true
    },
    "interval": {
      "outward_rounding_required_for_guarantees": true
    },
    "quantity": {
      "dimension_checked": true
    },
    "angle": {
      "unit_explicit": true,
      "default_unit": "radian"
    }
  },
  "runtime": {
    "silent_overflow": false,
    "implicit_float_conversion": false,
    "hidden_network_access": false,
    "deterministic_default": true,
    "random_seed_required": true,
    "prng_version_required": true,
    "typed_errors_required": true,
    "serialization_version_required": true
  },
  "verification": {
    "exact_reference_vectors_required": true,
    "boundary_tests_required": true,
    "differential_tests_required": true,
    "property_tests_required": true,
    "correctness_check_before_benchmark": true,
    "numerical_error_report_required": true,
    "algorithmic_complexity_report_required": true,
    "reference_vectors_file": "docs/K3_REFERENCE_VECTORS.json",
    "test_status_requires_actual_execution": true,
    "performance_claims_require_measurements": true,
    "reference_vector_schema_version": "1.2.0",
    "reference_implementation": "src/kaskad_k3",
    "reference_tests": [
      "tests/test_core.py",
      "tests/test_vectors.py"
    ],
    "reference_vector_schema": "schemas/k3-reference-vectors.v1.schema.json",
    "claim_registry_schema": "schemas/k3-claim-registry.v1.schema.json",
    "terminal_integral_exact_cases_require_declared_measure_and_exact_expected_value": true,
    "terminal_integral_tests_must_not_be_reported_as_general_proofs": true,
    "terminal_integral_backend_and_precision_must_be_explicit_if_numeric_backend_is_added": true,
    "terminal_integral_rejects_binary_float_inputs_for_exact_api": true,
    "terminal_integral_K3_encoder_rejects_nonintegral_and_negative_results": true,
    "terminal_integral_extended_real_survival_log_is_not_claimed_as_implemented": true
  },
  "experiment_manifest_required": [
    "experiment_id",
    "theory_version",
    "source_revision",
    "algorithm_version",
    "environment",
    "input_checksum",
    "parameters",
    "precision_and_rounding",
    "prng_and_seed",
    "timestamp",
    "outputs",
    "verification_status"
  ],
  "documentation_standard": {
    "edition": "Cascade Edition 1.0.0",
    "reference_vectors": "docs/K3_REFERENCE_VECTORS.json",
    "record_actual_tool_versions_only": true,
    "no_default_language_or_runtime_dependency": true,
    "measured_benchmarks_only": true,
    "unimplemented_algorithms_must_not_be_reported_as_implemented": true,
    "unexecuted_tests_must_not_be_reported_as_passed": true,
    "reproducibility_manifest_required_for_computational_claims": true,
    "data_provenance_and_sha256_required_when_data_are_used": true,
    "random_generator_version_and_seed_required_when_randomness_is_used": true,
    "non_applicable_fields_must_be_explicit": true
  }
}
